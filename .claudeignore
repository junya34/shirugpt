# Claude Code に読ませない/触らせないファイル。
# CLAUDE.md の「認証情報の中身は読まない」を、ツール側でも機械的に強制する。
# 除外対象は基本的に .gitignore と揃えている。

# ---------------------------------------------------------------
# 認証情報・シークレット（絶対に中身を読まない）
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# 認証情報ディレクトリ（サービスアカウントキーの置き場）
credentials/
credential/
.credentials/

# GCP サービスアカウントキー等
gcp-secret-key.json
*-key.json
*secret*.json
*_key.json
key*.json
keyfile*.json
credentials*.json
client_secret*.json
service-account*.json
service_account*.json
sa-*.json
gcp-*.json
application_default_credentials.json
adc.json
keys/
secrets/
*.pem
*.p12
*.pfx

# Streamlit の Secrets（OAuthのclient_secret等が入る）
.streamlit/secrets.toml

# ---------------------------------------------------------------
# Python（触る必要のない生成物）
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------
# 仮想環境（サイズが大きく、読む必要がない）
# ---------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------
# 抽出データ（顧客データが含まれうるため中身を読まない）
# ---------------------------------------------------------------
data/
exports/
*.csv
*.tsv
*.parquet
*.xlsx

# ---------------------------------------------------------------
# エディタ / OS / VCS
# ---------------------------------------------------------------
.git/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
.ipynb_checkpoints/
